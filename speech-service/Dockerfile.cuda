# Optional GPU recipe based on the runtime recommended by faster-whisper.
# Requires NVIDIA Container Toolkit and a compatible GPU host; not locally built.
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models \
    WHISPER_MODEL=small \
    WHISPER_DEVICE=cuda \
    WHISPER_COMPUTE_TYPE=float16 \
    WHISPER_CPU_THREADS=4

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN python3 -m pip install --no-cache-dir -r requirements.txt \
    && useradd --create-home --uid 10001 speech \
    && mkdir /models && chown speech:speech /models
COPY worker.py ./
USER speech
EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "worker:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
